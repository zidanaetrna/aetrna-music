# ==============================================================================
# Aetrna's Music Configuration Template
# ==============================================================================

# Required: Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Spotify API credentials for resolving spotify.com track & playlist links
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Bot Owner Discord User ID and Admin API Key
OWNER_ID=
ADMIN_KEY=

# Optional: Self-Hosted Web Dashboard Password (Defaults to random token if unset)
DASHBOARD_PASSWORD=

# System & Port Configuration
PORT=8080
PREFIX=/
DEFAULT_VOLUME=1.0
COOKIES_PATH=./cookies.txt
DB_PATH=./data/aetrna.db
CACHE_DIR=./data/cache
MAX_CACHE_SIZE_MB=5120
YTDLP_CLIENTS=ios,web,android,tv
