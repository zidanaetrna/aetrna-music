[Unit]
Description=aetrna-music Discord Bot (Staging)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aetrna-music/staging
ExecStart=/opt/aetrna-music/staging/bot
Restart=always
RestartSec=5
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
