[Unit]
Description=aetrna-music Discord Bot (Production)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aetrna-music/prod
ExecStart=/opt/aetrna-music/prod/bot
Restart=always
RestartSec=5
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
